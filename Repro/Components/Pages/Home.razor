@page "/"
@page "/repro"

<PageTitle>Chart lifecycle reproduction</PageTitle>

<h1>Chart lifecycle reproduction</h1>

<p>MudBlazor @typeof(MudChart<>).Assembly.GetName().Version / @RendererInfo.Name</p>
<p>Resize, then immediately navigate away or hide the chart.</p>

<div style="display:flex;flex-wrap:wrap;gap:12px;margin:16px 0">
    <button type="button" disabled="@(!RendererInfo.IsInteractive)" @onclick="() => _narrow = !_narrow">Resize chart</button>
    <button type="button" disabled="@(!RendererInfo.IsInteractive)" @onclick="() => _showChart = !_showChart">@(_showChart ? "Hide chart" : "Show chart")</button>
    <a href="/after">Navigate away</a>
</div>

<p id="chart-state">Width: @(_narrow ? 360 : 720)px; chart: @(_showChart ? "shown" : "hidden")</p>

<div id="chart-host" style="@($"width:{(_narrow ? 360 : 720)}px;max-width:100%")">
    @if (_showChart)
    {
        <MudChart T="double" ChartType="ChartType.Bar" ChartSeries="_series" ChartLabels="_labels"
                  Width="100%" Height="300px" MatchBoundsToSize="true" />
    }
</div>

@code {
    private bool _narrow;
    private bool _showChart = true;

    private readonly string[] _labels = ["A", "B", "C"];
    private readonly List<ChartSeries<double>> _series =
    [
        new() { Name = "First", Data = new double[] { 10, 20, 15 } },
        new() { Name = "Second", Data = new double[] { 15, 12, 25 } }
    ];
}
